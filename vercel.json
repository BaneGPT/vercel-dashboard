{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "devCommand": "vercel dev",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Negotiation-Token" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/$1" },
    { "source": "/affiliate", "destination": "/affiliate-index.html" },
    { "source": "/affiliate/(.*)", "destination": "/affiliate-index.html" },
    { "source": "/admin", "destination": "/admin-index.html" },
    { "source": "/admin/(.*)", "destination": "/admin-index.html" },
    { "source": "/negotiation", "destination": "/negotiation-victim.html" },
    { "source": "/negotiation/(.*)", "destination": "/negotiation-victim.html" },
    { "source": "/negotiation-admin", "destination": "/negotiation-admin.html" },
    { "source": "/negotiation-admin/(.*)", "destination": "/negotiation-admin.html" }
  ]
}